{
  "name": "work-1-study-cards",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first Anki-compatible study PWA with FSRS, note/card templates, Anki package interoperability, and optional Google Sheets sync.",
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "security": "node scripts/security-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run security",
    "e2e": "npm run build && node tests/browser.e2e.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "mathjax": "4.1.3",
    "sql.js": "1.14.1"
  }
}
